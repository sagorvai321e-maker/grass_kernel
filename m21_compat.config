# M21 external-module compatibility profile
# WARNING: This reduces module ABI/version checking. Only load modules
# compiled from compatible 4.14 Samsung/Exynos9611 sources.
CONFIG_MODULES=y
# Disable symbol CRC checks so CONFIG_MODVERSIONS mismatches do not reject modules.
# This does NOT make an incompatible module safe or universally compatible.
# CONFIG_MODVERSIONS is not set
CONFIG_MODULE_FORCE_LOAD=y
# Kernel module signatures are already disabled in the base M21 config.
# CONFIG_MODULE_SIG is not set
